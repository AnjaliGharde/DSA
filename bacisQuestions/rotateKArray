class Main{
    
    public static void rotate(int n, int arr[], int k){
        int temp[] = new int[k+1];
        int temp1[] = new int[n];
        
        for(int i=0;i<=k;i++){
            temp[i] = arr[i];
        }
        int z=0;
        
        for(int i=k+1;i<n;i++){
            temp1[z++] = arr[i];
            
        }
         int y = 0;
        for(int i=z;i<n;i++){
            temp1[i] = temp[y++];
        }
        
        for(int i=0;i<n;i++){
            System.out.println(temp1[i]);
        }
        
    }
    
    public static void main (String[] args) {
         int n =5;
         int  arr[] = {1,2,3,4,5};
         int k = 2;
         
         rotate(n,arr,k);
    }
}
