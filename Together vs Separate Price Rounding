 
// . Together vs Separate Price Rounding
// Problem Statement:
// You are given an integer N, representing the number of items, and an array prices[] containing the prices of these N items.
// You need to calculate the difference between two methods of rounding prices.
// Method 1: Together Sum
// 1.	Calculate the sum of all the prices.
// 2.	Round the total sum to the nearest multiple of 5 using the following rules:
// o	If the remainder when divided by 5 is 0, leave the number unchanged.
// o	If the remainder is 1 or 2, round down to the nearest multiple of 5.
// o	If the remainder is 3 or 4, round up to the nearest multiple of 5.
// Method 2: Separate Sum
// 1.	Round each individual price using the same rounding rules.
// 2.	Calculate the sum of all the individually rounded prices.
// Final Output:
// Print the difference:
// Answer = Separate Sum - Together Sum
// The answer can be positive, negative, or zero.
=================================================================================================================


public class Main
{
    
    public static int round(int prices[] , int N){
        
        int sum =0;
        for(int i=0; i<N; i++){
            sum+=prices[i];
            
        }
        
        if(sum % 5 == 1 || sum % 5 ==  2){
            while(sum % 5 == 0){
                sum -= 1;
            }
        }else if(sum % 5 == 3 || sum % 5 == 4){
            
              while(sum % 5 == 0){
                sum += 1;
            }
        }
        
        for(int i=0; i<N; i++){
            
            int temp = prices[i];
            
            if(temp % 5 == 1 || temp % 5 == 2){
                while(temp % 5 == 0){
                    temp -= 1;
                }
            }else if(temp % 5 == 3 || temp % 5 == 4){
            
              while(temp % 5 == 0){
                temp += 1;
            } 
        }
            
           int sep = 0;
           sep += temp;
            
        }
        
        int total = sep + sum;
        return total;
        
    }
