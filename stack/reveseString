import java.util.Stack;
class Main{

    public static void main (String[] args) {
        
        String str = "Hello";
        
        Stack<Character> stack = new Stack<>();
        
        for(int i=0;i<str.length();i++){
            stack.push(str.charAt(i));
        }
        
        String reverse = " ";
        
        for(int i=0;i<str.length(); i++){
            reverse += stack.pop();
        }
        
         System.out.println("reverse string : " + reverse);
    }
}
