 

 class Node{
        int data;
        Node next;
        
        
        Node(int data){
            this.data = data;
            this.next = null;
        }
    }
public class Main
{
    Node head;
    // insert at the end
   public void insert(int data){
       Node newnode = new Node(data);
       
       if(head == null){
           head = newnode;
           return;
       }
       Node temp = head;
       while(temp.next != null){
           temp = temp.next;
       }
       
       temp.next = newnode;
   }
   
//   insert at Start

    public void start(int data){
        
        Node newnode = new Node(data);
        
        if(head == null){
            head = newnode;
            return;
        }
        
         newnode.next = head;
         head = newnode;
    }
    
    // at the middle
    public void middle(int data , int position){
        Node newnode = new Node(data);
        
        Node temp = head;
        
        for(int i =0; i<position-1; i++){
             temp = temp.next;
        }
        
        newnode.next = temp.next;
        temp.next = newnode;
    }
    
    // delete the end Node
    public void deleteEnd(){
        Node temp = head;
        Node temp1 = temp.next;
        while(temp1.next != null){
            temp1 = temp1.next; 
            temp = temp.next;
        }
        
        temp.next = null;
        
    }
    
    // delete at the start
    public void startDelete(){
         head = head.next;
    }
   
   //   delete at middle
    public void deleteMiddle(int position){
        Node temp = head;
        Node temp1 = temp.next;
        for(int i=0;i<position-1;i++){
            temp = temp.next;
            temp1 = temp1.next;
        }
        
        temp.next = temp1.next;
        temp1.next = temp1;
        
        
    }
    
    
   public void display(){
        Node temp = head;
        
        while(temp != null){
            System.out.print(temp.data + "->");
            temp = temp.next;
        }
        
     System.out.print("null");
   }
   
   
   
	public static void main(String[] args) {
	    
	    Main list = new Main();
	    list.insert(10);
	    list.insert(20);
	    list.insert(30);
	    list.display();
	    System.out.println();
	    
	    list.start(80);
	    list.display();
	    System.out.println();
	    
	    list.middle(100,2);
	    list.display();
	    System.out.println();
	    
	    list.deleteEnd();
	    list.display();
	    System.out.println();
	    
	    list.startDelete();
	    list.display();
	    System.out.println();
	    
	    list.deleteMiddle(1);
	    list.display();
	    	 
	}
}

