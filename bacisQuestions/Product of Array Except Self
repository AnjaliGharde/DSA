 

public class Main
{
	public static void main(String[] args) {
	    
	    int arr[] = {1,2,3,4};
	     int ans[] = new int[arr.length];
	     
	     
	     for(int i=0;i<arr.length; i++){
	         int prod = 1;
	         
	         for(int j=0; j<arr.length; j++){
	             
	             if(i!=j){
	                 prod = prod * arr[j];
	             }
	         }
	         
	         ans[i] = prod;
	     }
	     
	    for(int i=0; i<ans.length; i++){
	        System.out.println(ans[i] + " ");
	    }
 	}
}
