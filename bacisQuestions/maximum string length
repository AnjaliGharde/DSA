 

public class Main
{
	public static void main(String[] args) {
	    
	    String str = "abcabcbb";
	     int maxlength = 0;
	    
	    for(int i=0; i<str.length(); i++){
	        
	        String sub ="";
	        
	        for(int j=0;j<str.length();j++){
	            
	            char ch = str.charAt(j);
	            
	            if(sub.indexOf(ch)!= -1){
	                break;
	            }
	            
	            sub += ch;
	            
	            if(sub.length()>maxlength){
	                maxlength = sub.length();
	            }
	        }
	        
	        
	    }
	    
	    System.out.println(maxlength);
 	}
}
