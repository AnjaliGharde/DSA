//  5. Longest Contiguous Subarray With Adjacent Difference at Most L
// Problem Statement:
// You are given an array arr[1...N] and a limit L.
// You need to find the length of the longest contiguous subarray in which no 
// two adjacent elements differ by more than L.
// That is, for every pair of consecutive elements in the chosen subarray:
// \[ |a[i+1]-a[i]| \leq L \]
// Find the length of the longest contiguous subarray satisfying this condition.
// Constraints:
// 1 <= N <= 10^5
// 0 <= L <= 10^9
// 0 <= a[i] <= 10^9
// Given:
// •	An integer array arr.
// •	An integer limit L.
// Output:
// Return the length of the longest valid contiguous subarray.


public class Main
{
    public static int logest(int arr[], int L){
        
        int count = 1;
        int maxLength = 1;
        
        
        for(int i=0; i<arr.length-1; i++){
              int diff = Math.abs(arr[i+1] - arr[i]);
              
              if(diff <=  L){
                  count ++;
              }else{
                  count = 1;
              }
              
               maxLength = Math.max(maxLength, count);
        }
        
        
        
        return maxLength;
       
        
        
    }
	public static void main(String[] args) {
	    
	    int arr[] = {1, 3, 5, 4, 10, 11};
	    
	   int L = 2;
		 
		 System.out.println(logest(arr, L));
		 
		 
		 
	}
}
