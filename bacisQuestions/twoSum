class Main{
    
    public static void twoSum(int n, int arr[], int target){
       int sum;
        for(int i=0; i<n;i++){
            for(int j=i+1;j<n;j++){
               sum = arr[i] + arr[j];
               
               if(sum==target){
            System.out.println(arr[i] + " and " + arr[j]);
            }
            }
             
        }
        
    }
    
    public static void main (String[] args) {
         int n =5;
         int  arr[] = {1,2,3,4,5};
         int target = 5;
         
         twoSum(n,arr,target);
    }
}
