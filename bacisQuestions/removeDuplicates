 

public class Main
{
    public static int [] removeduplicates(int n, int arr[]){
        int temp[] = new int[n];
        int k=0;
        
        for(int i=0;i<n;i++){
            
            boolean found = false;
            
            for(int j=0;j<k;j++){
                if(arr[i] == temp[j]){
                     found = true;
                     break;
                }
            }
            
            if(!found){
                temp[k] = arr[i];
                k++;
            }
        }
        
        int result[] = new int[k];
        for(int i=0;i<k;i++){
            result[i] = temp[i];
        }
        return result;
    }
    
	public static void main(String[] args) {
		 int n = 5;
		 int arr[] = {2,3,4,2,4};
		 
		 int ans[] = removeduplicates(n, arr);
		 
		 for(int i=0;i<ans.length;i++){
		     System.out.println(ans[i] + " ");
		 }
		 
		 
	}
}
