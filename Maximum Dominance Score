Problem Statement: Maximum Dominance Score
You are given an array A consisting of N integers and an integer K.
Your task is to divide the array into exactly K non-empty contiguous subarrays.
The dominance score of a subarray is defined as the maximum frequency of any element in that subarray.
For example,
Subarray = [2, 3, 2, 4, 2]
•	Frequency of 2 = 3
•	Frequency of 3 = 1
•	Frequency of 4 = 1
Dominance Score = 3
The score of a partition is the sum of the dominance scores of all K subarrays.
Find the maximum possible score.
============================================================================================================




import java.util.*;

public class Main {

    public static int solve(int arr[], int start, int k) {

        int n = arr.length;

        // Base condition
        if (k == 1) {

            HashMap<Integer, Integer> map = new HashMap<>();
            int maxFreq = 0;

            for (int i = start; i < n; i++) {

                int count = map.getOrDefault(arr[i], 0) + 1;
                map.put(arr[i], count);

                maxFreq = Math.max(maxFreq, count);
            }

            return maxFreq;
        }

        int ans = 0;

        for (int end = start; end <= n - k; end++) {

            HashMap<Integer, Integer> map = new HashMap<>();
            int maxFreq = 0;

            for (int i = start; i <= end; i++) {

                int count = map.getOrDefault(arr[i], 0) + 1;
                map.put(arr[i], count);

                maxFreq = Math.max(maxFreq, count);
            }

            int remaining = solve(arr, end + 1, k - 1);

            ans = Math.max(ans, remaining + maxFreq);
        }

        return ans;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int arr[] = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        System.out.println(solve(arr, 0, k));

        sc.close();
    }
}
