import java.util.Stack;
public class Main
{
    
    public static void findMiddle(Stack<Integer> st){
        
        int size = st.size();
        int middle = size / 2;
        
        Stack<Integer> temp = new Stack<>();
        
        
        for(int i=0;i<=middle;i++){
            temp.push(st.pop());
        }
        
        System.out.println("middle element : " + temp.peek());
        
        while(!temp.isEmpty()){
            st.push(temp.pop());
        }
    } 
    
	public static void main(String[] args) {
	    	Stack<Integer> st = new Stack<>();
	    	
	    	st.push(10);
	    	st.push(20);
	    	st.push(30);
	    	st.push(40);
	    	st.push(50);
findMiddle(st);
	} 
}

