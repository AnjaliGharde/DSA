public class Main
{
    static int n = 4;

    public static boolean solveMaze(int maze[][],
                                    int x,
                                    int y,
                                    int sol[][])
    {
        // Destination reached
        if(x == n - 1 && y == n - 1 && maze[x][y] == 1)
        {
            sol[x][y] = 1;
            return true;
        }

        // Check safe path
        if(isSafe(maze, x, y))
        {
            sol[x][y] = 1;

            // Move Down
            if(solveMaze(maze, x + 1, y, sol))
            {
                return true;
            }

            // Move Right
            if(solveMaze(maze, x, y + 1, sol))
            {
                return true;
            }

            // Backtracking
            sol[x][y] = 0;

            return false;
        }

        return false;
    }

    public static boolean isSafe(int maze[][], int x, int y)
    {
        return (x >= 0 &&
                y >= 0 &&
                x < n &&
                y < n &&
                maze[x][y] == 1);
    }

    public static void printSolution(int sol[][])
    {
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < n; j++)
            {
                System.out.print(sol[i][j] + " ");
            }

            System.out.println();
        }
    }

    public static void main(String[] args)
    {
        int maze[][] =
        {
            {1, 0, 0, 0},
            {1, 1, 0, 1},
            {0, 1, 0, 0},
            {1, 1, 1, 1}
        };

        int sol[][] = new int[n][n];

        if(solveMaze(maze, 0, 0, sol))
        {
            printSolution(sol);
        }
        else
        {
            System.out.println("No Path Found");
        }
    }
}
